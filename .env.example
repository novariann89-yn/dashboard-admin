# Local development uses a plain SQLite file (no env needed).
# For production (Turso), set these on Vercel:
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=<turso-token>

# Session secret (random string). Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# Hashed admin PIN. Generate: npm run hash-pin -- <your-pin>
ADMIN_PIN_HASH=change-me