{
  "name": "dashbord-admin",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "allowScripts": ["esbuild@*"],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lan": "node scripts/serve-lan.mjs",
    "cert": "bash scripts/make-cert.sh",
    "restart": "bash scripts/restart-lan.sh --detach",
    "stop": "pkill -f \"[s]erve-lan\" || true"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}